# Copy to .env and adjust. Never commit .env.
# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=habittracker
POSTGRES_USER=habittracker
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# --- Backend (HabitTracker.Api) ---
# Overrides appsettings via env vars, e.g.:
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=habittracker;Username=habittracker;Password=change_me_locally
# Jwt__SigningKey=<generate: openssl rand -base64 48>
# Cors__AllowedOrigins__0=http://localhost:3000
# Frontend__BaseUrl=http://localhost:3000

# --- Google sign-in (optional; the button hides itself when unset) ---
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
# Authentication__Google__RedirectUri=http://localhost:5000/api/v1/auth/google/callback

# --- Reminder emails (optional; scheduler is off unless enabled) ---
# Reminders__Enabled=true
# Reminders__PollIntervalMinutes=5
# Email__ApiBaseUrl=http://localhost:5000
# Email__FromAddress=hatirlatma@example.com
# Email__SmtpHost=smtp.example.com      # unset -> reminders are logged, not sent
# Email__SmtpPort=587
# Email__SmtpUser=
# Email__SmtpPassword=

# --- Frontend ---
# NEXT_PUBLIC_API_URL=http://localhost:5000

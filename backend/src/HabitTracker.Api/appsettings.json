    "Issuer": "habittracker",
    "Audience": "habittracker",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Frontend": {

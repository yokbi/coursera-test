  },
  "Reminders": {
    "Enabled": false,
    "PollIntervalMinutes": 5
  },
  "Email": {
    "FromAddress": "hatirlatma@habittracker.local",
    "FromName": "Alışkanlık Takibi",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseSsl": true,
    "SmtpUser": "",
    "SmtpPassword": ""
